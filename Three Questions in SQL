SELECT * FROM TRANSACTIONS WHERE CST_LCN = "Kolkata";

SELECT * FROM TRANSACTIONS;
SELECT * FROM TRANSACTIONS ORDER BY CST_LCN;

SELECT CST_ID, CST_NAME, CST_LCN, CST_BAL FROM TRANSACTIONS AS TR WHERE TR.CST_BAL IN (SELECT MAX(CST_BAL) FROM TRANSACTIONS WHERE TR.CST_LCN = CST_LCN);

SELECT CST_LCN, COUNT(CST_LCN) FROM TRANSACTIONS GROUP BY CST_LCN ORDER BY COUNT(CST_LCN) DESC LIMIT 1;

SELECT CST_LCN, SUM(TR_AMT) FROM TRANSACTIONS GROUP BY CST_LCN ORDER BY SUM(TR_AMT) DESC LIMIT 1;
