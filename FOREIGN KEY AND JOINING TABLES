CREATE DATABASE PROF_SUBJECTS;
USE PROF_SUBJECTS;

CREATE TABLE SUBJECTS
    SUB_CODE INT PRIMARY KEY,				                              	#PRIMARY KEY
    SUBJECT VARCHAR(50)
);

