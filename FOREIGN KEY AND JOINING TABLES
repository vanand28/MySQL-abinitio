SELECT * FROM SUBJECTS;
SELECT * FROM PROFESSORS;

SELECT SUBJECT FROM SUBJECTS
UNION									#UNION OPERATOR
SELECT PROF_NAME FROM PROFESSORS;

SELECT SUBJECT FROM SUBJECTS
UNION ALL								#UNION ALL OPERATOR
SELECT PROF_NAME FROM PROFESSORS;

SELECT * FROM SUBJECTS INNER JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID;		        	#USING INNER JOIN

SELECT * FROM SUBJECTS LEFT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID;		         	#USING LEFT JOIN

SELECT * FROM SUBJECTS RIGHT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID;		         	#USING RIGHT JOIN

SELECT * FROM SUBJECTS LEFT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID
UNION								                                                                              		#FULL OUTER JOIN IS COMBINATION/UNION OF LEFT AND RIGHT JOINS
SELECT * FROM SUBJECTS RIGHT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID;

SELECT * FROM SUBJECTS LEFT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID WHERE PROFESSORS.COURSE_ID IS NULL;

SELECT * FROM SUBJECTS RIGHT JOIN PROFESSORS ON SUBJECTS.SUB_CODE = PROFESSORS.COURSE_ID WHERE PROFESSORS.COURSE_ID IS NULL;
