CREATE TABLE PROFESSORS(
    EMP_ID INT PRIMARY KEY,
    PROF_NAME VARCHAR(50),
    COURSE_ID INT,
    FOREIGN KEY (COURSE_ID) REFERENCES SUBJECTS(SUB_CODE)	                        	#FOREIGN KEY
    ON DELETE CASCADE
    ON UPDATE CASCADE
);

