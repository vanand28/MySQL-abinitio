CREATE DATABASE COLLEGE;				  	#CREATING DATABASE
USE COLLEGE;						            #GETTING THE CODE ACCESS THE DATABASE

DROP DATABASE COLLEGE;					  	#DELETING THE DATABASE (select and run the command)

CREATE TABLE STUDENT (						  #CREATING TABLE IN THE DATABASE AND COLUMNS SPECIFIED WITH ATTRIBUTES
    ROLLNO INT PRIMARY KEY,			 		#ATTRIBUTES - INTEGER, PRIMARY KEY
    NAME VARCHAR(50),					      #ATTRIBUTE - VARCHAR (CHARACTER INPUT WITH MAX CAPACITY AS GIVEN)
    MARKS INT NOT NULL,				  		#ATTRIBUTES - INTEGER, NOT NULL (CAN'T HOLD AN EMPTY SPACE)
    GRADE VARCHAR(2),
    CITY VARCHAR(20)
);

INSERT INTO STUDENT						             #INSERTING VALUES INTO THE TABLE
(ROLLNO, NAME, MARKS, GRADE, CITY)				 #ENTERING VALUES IN THE SAME CHRONOLOGY 
VALUES               						           #THE STRINGS ARE WRITTEN IN QUOTES - "STRING"
(101, "ANIL", 78, "C", "PUNE"),
(102, "BHUMKIKA", 93, "A", "MUMBAI"),
(103, "CHETAN", 85, "B", "MUMBAI"),
(104, "DHRUV", 96, "A", "DELHI"),
(105, "EMANUEL", 12, "F", "DELHI"),
(106, "FARAH", 82, "B", "DELHI");

DROP TABLE STUDENT;						            #DELETING THE TABLE (select and run the command)
SELECT * FROM STUDENT;				      		  #SHOW 'ALL' FROM THE TABLE 'STUDENT'[* represents ALL]
SELECT NAME, CITY FROM STUDENT;					  #SELECTING SPECIFIC COLUMNS
SELECT DISTINCT CITY FROM STUDENT;				#NO VALUE FROM THE COLUMN REPEATS

SELECT * FROM STUDENT WHERE MARKS>75 AND CITY="MUMBAI";		
SELECT * FROM STUDENT WHERE MARKS>85 OR MARKS<20;
SELECT * FROM STUDENT WHERE CITY="DELHI" OR CITY="MUMBAI";
SELECT * FROM STUDENT WHERE MARKS BETWEEN 75 AND 90;
SELECT * FROM STUDENT WHERE CITY IN ("PUNE","MUMBAI");
SELECT * FROM STUDENT WHERE CITY NOT IN ("PUNE","MUMBAI");

SELECT * FROM STUDENT ORDER BY ROLLNO DESC;
SELECT * FROM STUDENT ORDER BY MARKS ASC;

SELECT COUNT(ROLLNO) FROM STUDENT;						#COUNTING ELEMENTS IN A COLUMN
SELECT MAX(MARKS) FROM STUDENT;								#SELECTS MAXIMUM VALUE
SELECT MIN(MARKS) FROM STUDENT;								#SELECTS MINIMUM VALUE
SELECT SUM(MARKS) FROM STUDENT;								#CALCULATES SUM
SELECT AVG(MARKS) FROM STUDENT;								#CALCULATES AVERAGE

SELECT CITY, COUNT(NAME) FROM STUDENT GROUP BY CITY;
SELECT CITY, AVG(MARKS) FROM STUDENT GROUP BY CITY ORDER BY AVG(MARKS) DESC;
SELECT CITY, COUNT(NAME) AS "NO OF STUDENTS" FROM STUDENT GROUP BY CITY;
SELECT CITY, COUNT(NAME) FROM STUDENT GROUP BY CITY HAVING MAX(MARKS)>90;		

SET SQL_SAFE_UPDATES=0;					      		#ESSENTIAL STEP BEFORE USING THE 'UPDATE' COMMANDS, REVERSE IT BY REPLACING 0 BY 1

UPDATE STUDENT SET GRADE="RT" WHERE GRADE="F";

UPDATE STUDENT SET GRADE="B" WHERE MARKS BETWEEN "75" AND "90";

UPDATE STUDENT SET MARKS=MARKS+1;

DELETE FROM STUDENT WHERE MARKS < 33;

ALTER TABLE STUDENT CHANGE COLUMN NAME FULL_NAME VARCHAR(50);

DELETE FROM STUDENT WHERE MARKS < 80;

ALTER TABLE STUDENT DROP COLUMN GRADE;

SELECT FULL_NAME, MARKS FROM STUDENT WHERE MARKS > (SELECT AVG(MARKS) FROM STUDENT);

SELECT ROLLNO, FULL_NAME FROM STUDENT WHERE ROLLNO IN (SELECT ROLLNO FROM STUDENT WHERE ROLLNO % 2 = 0);
